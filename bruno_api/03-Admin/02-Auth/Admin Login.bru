meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/login/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

vars:post-response {
  adminAccessToken: res.body && res.body.data ? res.body.data.access : (res.body ? res.body.access : "")
}

tests {
  test("Status code is 200 OK or 401 (if credentials not seeded yet)", function() {
    expect([200, 401]).to.include(res.getStatus());
  });

  test("Admin JWT token stored for folder requests on success", function() {
    if (res.getStatus() === 200) {
      expect(bru.getVar("adminAccessToken")).to.be.a("string").and.not.empty;
    }
  });
}

docs {
  # Administrator Login
  
  Authenticates administrator and captures `adminAccessToken` for admin-scoped requests.
}
