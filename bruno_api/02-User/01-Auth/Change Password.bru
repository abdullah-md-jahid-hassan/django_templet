meta {
  name: Change Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/password/change/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "old_password": "{{userPassword}}",
    "new_password": "{{userPassword}}"
  }
}

tests {
  test("Status code is 200 OK or 400 (if password mismatch)", function() {
    expect([200, 400]).to.include(res.getStatus());
  });

  test("Unified response envelope format", function() {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("success");
    expect(body).to.have.property("message");
  });

  test("Password change success confirmation", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.success).to.be.true;
      expect(body.message).to.equal("Password changed successfully");
    }
  });
}

docs {
  # Change Password Endpoint
  
  Allows an authenticated user to change their password by supplying their current password.
  
  - **Method**: `POST`
  - **Path**: `/v1/auth/password/change/`
  - **Auth**: Bearer Token (Inherited)
  - **Payload**:
    - `old_password`: Current account password
    - `new_password`: New strong password
}
