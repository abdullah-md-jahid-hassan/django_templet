meta {
  name: Change Password - Wrong Old Password (Validation Test)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/password/change/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "old_password": "WrongPasswordEntered999!",
    "new_password": "BrandNewPassword123!"
  }
}

tests {
  test("Status code is 400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("Error message specifies incorrect password", function() {
    const body = res.getBody();
    expect(body.success).to.be.false;
    expect(body.message).to.equal("Current password is incorrect");
  });
}

docs {
  # Change Password - Wrong Password Validation Test
  
  Ensures that providing an incorrect current password rejects the update request with HTTP 400 Bad Request.
}
