# ==============================================================================
# Bruno API Secrets - Example Template
# Copy this file to `development.secrets.env` or `production.secrets.env`
# and populate with your own credentials and sensitive tokens.
#
# DO NOT commit actual secrets or credentials to source control.
# ==============================================================================

# User Credentials
BRUNO_USER_EMAIL=user@example.com
BRUNO_USER_PASSWORD=YourSecurePassword123!

# Admin Credentials
BRUNO_ADMIN_EMAIL=admin@example.com
BRUNO_ADMIN_PASSWORD=YourAdminPassword123!

# Test Tokens (Populated dynamically during runtime or manually overridden)
BRUNO_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
BRUNO_REFRESH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
