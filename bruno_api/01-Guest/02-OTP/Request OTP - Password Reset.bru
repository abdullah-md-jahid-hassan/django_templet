meta {
  name: Request OTP - Password Reset
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{apiPrefix}}/otp/get-otp/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "purpose": "password_reset",
    "user_identifier": "testuser@example.com",
    "otp_channel": "email"
  }
}

tests {
  test("Status code is 200 or 404", function() {
    expect([200, 404]).to.include(res.getStatus());
  });

  test("Unified response envelope format", function() {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("success");
    expect(body).to.have.property("message");
  });

  test("Valid user receives OTP confirmation", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.success).to.be.true;
      expect(body.message).to.include("OTP sent successfully");
    }
  });
}

docs {
  # Request OTP for Password Reset
  
  Dispatches a one-time password reset code to a registered user's email address.
  
  - **Method**: `POST`
  - **Path**: `/v1/otp/get-otp/`
  - **Auth**: None (Public)
  - **Payload**:
    - `purpose`: `"password_reset"`
    - `user_identifier`: Existing user's registered email
    - `otp_channel`: `"email"`
}
