meta {
  name: Login - Invalid Credentials (Validation Test)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/login/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "nonexistent_or_wrong@example.com",
    "password": "WrongPassword123!"
  }
}

tests {
  test("Status code is 401 Unauthorized", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("Error details returned without leaking internal information", function() {
    const body = res.getBody();
    expect(body).to.be.an("object");
  });
}

docs {
  # Login Invalid Credentials Validation Test
  
  Confirms that incorrect credentials receive HTTP 401 Unauthorized without exposing internal stack traces.
}
