meta {
  name: Reset Password via OTP
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}{{apiPrefix}}/auth/password/reset/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "otp": "{{resetOtp}}",
    "new_password": "{{userPassword}}"
  }
}

tests {
  test("Status code is 200 OK or 400 (if invalid OTP)", function() {
    expect([200, 400]).to.include(res.getStatus());
  });

  test("Unified response envelope format", function() {
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body).to.have.property("success");
    expect(body).to.have.property("message");
  });

  test("Password reset success confirmation", function() {
    if (res.getStatus() === 200) {
      const body = res.getBody();
      expect(body.success).to.be.true;
      expect(body.message).to.include("Password reset successfully");
    }
  });
}

docs {
  # Complete Password Reset via OTP
  
  Resets a user's password using the OTP code received from `/v1/otp/get-otp/`.
  
  - **Method**: `POST`
  - **Path**: `/v1/auth/password/reset/`
  - **Auth**: None (Public)
  - **Payload**:
    - `email`: string
    - `otp`: string
    - `new_password`: string
}
